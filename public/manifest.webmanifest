{
  "name": "Yapper",
  "short_name": "Yapper",
  "description": "Free chat for your communities and friends.",
  "id": "/",
  "start_url": "/channels/@me",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#141b18",
  "theme_color": "#00d087",
  "categories": ["social", "communication"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/badge-96.png", "sizes": "96x96", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    { "name": "Friends", "url": "/channels/@me", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/channels/@me",
    "method": "GET",
    "params": { "text": "share_text", "url": "share_url" }
  }
}
