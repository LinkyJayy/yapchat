{
  "name": "yapper-desktop",
  "productName": "Yapper",
  "version": "1.0.0",
  "description": "Yapper desktop app for Windows, macOS and Linux.",
  "main": "main.js",
  "private": true,
  "author": "Yapper",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.yapper.desktop",
    "productName": "Yapper",
    "files": ["main.js", "preload.js", "setup.html", "build/icon.png"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "mac": { "target": ["dmg"], "icon": "build/icon.png", "category": "public.app-category.social-networking" },
    "linux": { "target": ["AppImage", "deb"], "icon": "build/icon.png", "category": "Network" }
  }
}
